+def sanitize_messages(messages):
+    """最后一道校验：剔除 OpenAI 兼容端点会整单拒绝的消息。
+
+    DeepSeek 等端点遇到 content 与 tool_calls 同时为空的 assistant 消息时，会直接
+    返回 400 Invalid assistant message: content or tool_calls must be set。
+    引用问答、会话命名、追问建议等历史回放逻辑很容易带进这种占位消息；一旦发出，
+    后续每次请求都会失败，所以在真正发请求前统一兜底。
+    """
+
+    def is_empty(value) -> bool:
+        if value is None:
+            return True
+        if isinstance(value, str):
+            return not value.strip()
+        if isinstance(value, (list, tuple, dict, set)):
+            return len(value) == 0
+        return False
+
+    if not messages:
+        return messages
+
+    cleaned = []
+    for message in messages:
+        if isinstance(message, dict) and (
+            message.get("role") == "assistant"
+            and not message.get("tool_calls")
+            and is_empty(message.get("content"))
+        ):
+            continue
+        cleaned.append(message)
+
+    if not cleaned:
+        # 兜底：优先保留最后一条非 assistant 消息；实在没有就补一句中性提问，
+        # 总之不能把空 messages 或空 assistant 发出去
+        tail = next(
+            (
+                m
+                for m in reversed(messages)
+                if not (isinstance(m, dict) and m.get("role") == "assistant")
+            ),
+            None,
+        )
+        cleaned = [tail] if tail is not None else [{"role": "user", "content": "请继续。"}]
+
+    if len(cleaned) != len(messages):
+        import logging  # noqa: WPS433
+
+        logging.getLogger(__name__).warning(
+            "已丢弃 %d 条空 assistant 消息，避免端点整单拒绝",
+            len(messages) - len(cleaned),
+        )
+    return cleaned
+
+
